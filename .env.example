# Copy to .env (chmod 600). Never commit .env.
# AI Summarizer / Translate use any OpenAI-compatible chat endpoint.
# Leave LLM_MODEL empty to keep AI features in "basic mode".
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
